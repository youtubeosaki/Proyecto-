# =============================================================================
# Osaki - configuracion. Copia este archivo a .env y rellena lo que uses.
#   PowerShell:  Copy-Item .env.example .env
# NUNCA commitees .env. Esta en .gitignore.
# =============================================================================

# --- Proveedor de LLM ---------------------------------------------------------
# mock   : respuestas desde fixtures en disco. Gasto cero. Para desarrollo y tests.
# manual : escribe el prompt a data/exchange/ y espera que pegues la respuesta.
#          Usa tu suscripcion de claude.ai. No consume creditos de API.
# api    : SDK de Anthropic. Requiere ANTHROPIC_API_KEY y credito cargado.
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
# Modelo por defecto para etapas creativas (investigacion, angulos, guion).
LLM_MODEL_PRIMARY=claude-opus-5
# Modelo para trabajo mecanico (tags, titulos, deteccion de segmentos).
LLM_MODEL_UTILITY=claude-haiku-4-5
# low | medium | high | xhigh | max
LLM_EFFORT=high

# --- Verificacion de fuentes --------------------------------------------------
# exclude : las afirmaciones sin fuente primaria NO llegan al guion (por defecto).
# flag    : llegan al guion marcadas como no verificadas.
UNVERIFIED_CLAIMS_POLICY=exclude
# Minimo de afirmaciones verificadas para permitir que un tema avance a guion.
MIN_VERIFIED_CLAIMS=8

# --- Voz ----------------------------------------------------------------------
# file       : tu grabacion. Dejas el archivo en data/audio/<videoId>/narration.wav
# piper      : TTS local, gratis. Para borradores de timing.
# elevenlabs : TTS de pago.
VOICE_PROVIDER=file
PIPER_BIN=piper
PIPER_VOICE_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Alineacion de audio a escenas (whisper.cpp local, gratis)
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=

# --- Render -------------------------------------------------------------------
# Vacio = Remotion usa su propio ffmpeg embebido.
FFMPEG_PATH=
RENDER_CONCURRENCY=2
RENDER_QUALITY=high

# --- YouTube (Fase 5) ---------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5678/oauth/youtube/callback
YOUTUBE_REFRESH_TOKEN=
# private | unlisted. NUNCA public: la publicacion pasa por aprobacion humana.
YOUTUBE_DEFAULT_PRIVACY=private

# --- n8n ----------------------------------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_TOKEN=

# --- Rutas y estado -----------------------------------------------------------
DATA_DIR=./data
DATABASE_PATH=./data/osaki.db
LOG_LEVEL=info
